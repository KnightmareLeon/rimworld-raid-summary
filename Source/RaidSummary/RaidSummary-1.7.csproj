<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RaidSummary</AssemblyName>
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <RimWorld17Dir>C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorld17Dir>
    <RimWorld17Managed>$(RimWorld17Dir)\RimWorldWin64_Data\Managed</RimWorld17Managed>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorld17Dir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityStubs">
      <HintPath>$(RimWorld17Dir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Waylith">
      <HintPath>$(RimWorld17Dir)\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony.Ref" Version="3.0-rc.2" />
  </ItemGroup>

</Project>